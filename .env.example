# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# What milestones 1 to 6 need. Messaging credentials arrive with the
# milestone that uses them — there is nothing to configure for them yet.

# --- App ---
VOICEDESK_ENVIRONMENT=local
# Leave false outside development: it enables FastAPI's debug behaviour.
VOICEDESK_DEBUG=true

# --- Database ---
VOICEDESK_DATABASE_URL=postgresql+psycopg://voicedesk:voicedesk@localhost:5432/voicedesk

# Used only by the test suite, which migrates and tears this database down on
# every run — never point it at the database above.
VOICEDESK_TEST_DATABASE_URL=postgresql+psycopg://voicedesk:voicedesk@localhost:5432/voicedesk_test

# --- Calendar ---
# Which wall clock `business_hours` is written in. Appointments are stored as
# instants; this is what turns "opens at 09:00" into one. Set your own.
VOICEDESK_BUSINESS_TIMEZONE=UTC
# The grid available start times sit on, measured from each opening time.
VOICEDESK_SLOT_GRANULARITY_MINUTES=15

# --- Dialogue ---
# Leave blank and the SDK resolves credentials from its own environment. No
# test needs a key: the model is injected, and nothing in the suite is allowed
# to reach the network.
VOICEDESK_ANTHROPIC_API_KEY=
VOICEDESK_DIALOGUE_MODEL=claude-opus-5
# Ceiling on one reply. A receptionist answers in about two sentences; the
# headroom is for a turn that also carries tool calls.
VOICEDESK_DIALOGUE_MAX_TOKENS=1024
# Thinking depth: low, medium, high, xhigh or max. The latency budget is 1.2
# seconds from the caller stopping, so the default is the shallowest.
VOICEDESK_DIALOGUE_EFFORT=low
# How many times one caller turn may go round the model/tool loop before the
# dialogue layer stops it and hands over to a human.
VOICEDESK_MAX_TOOL_ITERATIONS=8

# --- Speech ---
# The defaults are offline: a fixed transcript and a tone, so the browser
# harness runs with no account, no network and no bill. They are a harness,
# not speech recognition and not a voice.
#
# For real speech set the provider and its key:
#   VOICEDESK_STT_PROVIDER=deepgram
#   VOICEDESK_TTS_PROVIDER=elevenlabs
VOICEDESK_STT_PROVIDER=offline
VOICEDESK_TTS_PROVIDER=offline
VOICEDESK_DEEPGRAM_API_KEY=
VOICEDESK_ELEVENLABS_API_KEY=
VOICEDESK_STT_MODEL=nova-3
# An ElevenLabs voice id, and optionally a model id.
VOICEDESK_TTS_VOICE=
VOICEDESK_TTS_MODEL=
# The one audio format the system accepts: 16 kHz mono 16-bit PCM in a WAV
# container. Telephony's 8 kHz µ-law arrives with the milestone that needs it.
VOICEDESK_AUDIO_SAMPLE_RATE=16000
# One utterance. Roughly 32 seconds at the rate above.
VOICEDESK_MAX_UTTERANCE_BYTES=1048576
VOICEDESK_SPEECH_TIMEOUT_SECONDS=10.0

# --- Telephony ---
# Off, and every credential blank. Nothing telephonic is reachable until this
# is switched on: with it false, POST /telephony/voice answers 404 and the
# media socket closes immediately.
VOICEDESK_TELEPHONY_ENABLED=false
VOICEDESK_TWILIO_ACCOUNT_SID=
# Also the key the webhook signature is checked against. A secret: never
# commit a real one, and never log it.
VOICEDESK_TWILIO_AUTH_TOKEN=
VOICEDESK_TWILIO_PHONE_NUMBER=
# The address the carrier can reach from the internet — an ngrok or Cloudflare
# tunnel while developing. It cannot be derived from the request: behind a
# proxy the request describes the hop, not the public address. The TwiML
# stream URL and the signed URL are both built from this.
VOICEDESK_PUBLIC_BASE_URL=
# Leave true. False is only for replaying a captured request locally; an
# unsigned webhook is an open door to this database and this model budget.
VOICEDESK_VALIDATE_TWILIO_SIGNATURE=true

# --- The temporary utterance boundary ---
# A carrier streams continuously and the dialogue layer wants complete
# utterances. This is an amplitude timer and nothing more — not voice-activity
# detection — and the milestone that owns real-time behaviour replaces it.
# Milliseconds below the threshold before an utterance is considered finished.
VOICEDESK_TELEPHONY_SILENCE_MS=800
# Mean absolute 16-bit sample value below which a frame counts as silence.
VOICEDESK_TELEPHONY_SILENCE_THRESHOLD=500
# A caller who has not paused for this long is answered anyway. Also what
# bounds the buffer on an open socket.
VOICEDESK_TELEPHONY_MAX_UTTERANCE_MS=30000

# --- Realtime ---
# Off by default: with it false the milestone-6 behaviour runs — one complete
# utterance, then one complete reply. Switch it on for continuous audio,
# voice-activity detection and barge-in.
VOICEDESK_REALTIME_ENABLED=false
VOICEDESK_STT_STREAMING_PROVIDER=offline
VOICEDESK_TTS_STREAMING_PROVIDER=offline
# What a carrier sends, and the grain everything works in.
VOICEDESK_AUDIO_FRAME_MS=20

# --- Voice activity ---
# An energy detector, not a trained one. It measures how much louder than the
# room something is; it cannot tell a caller from a television, and sustained
# noise above the margin reads as speech. See the README.
VOICEDESK_VAD_MIN_SPEECH_MS=120
VOICEDESK_VAD_ENERGY_THRESHOLD=300
VOICEDESK_VAD_NOISE_FLOOR_ALPHA=0.05
VOICEDESK_VAD_HYSTERESIS=0.6
# Audio kept from before the detector was convinced, so the first syllable is
# not clipped.
VOICEDESK_VAD_PREROLL_MS=200

# --- Endpointing ---
VOICEDESK_ENDPOINT_SILENCE_MS=700
# A caller who never pauses is answered anyway. Also what bounds the buffer.
VOICEDESK_ENDPOINT_MAX_UTTERANCE_MS=20000

# --- Interruption ---
VOICEDESK_BARGE_IN_ENABLED=true

# --- Cost ---
# Off by default: with it false nothing writes a cost row and
# `calls.total_cost_usd` stays null.
VOICEDESK_COST_TRACKING_ENABLED=false
# VoiceDesk ships NO vendor prices. These are empty on purpose, and empty
# means "unpriced" — not "free". A component nobody has priced is recorded
# with its usage and a null cost, and a call with any unpriced component has
# no total at all.
#
# Fill them in from your own accounts, in the units the vendors quote in.
# One price per component: if you change model or speech provider, change the
# price with it, because nothing here notices that you did not.
VOICEDESK_LLM_INPUT_USD_PER_MTOK=
VOICEDESK_LLM_OUTPUT_USD_PER_MTOK=
VOICEDESK_STT_USD_PER_MINUTE=
VOICEDESK_TTS_USD_PER_MCHAR=
# There is deliberately no telephony price. What this system can measure is
# how long its media stream was open; what a carrier bills is its own record
# of the call, rounded up, which this process never sees. The duration is
# recorded; it is never costed.

# --- Evaluation ---
# Where `python -m app.evals` runs. Blank derives one by appending `_evals` to
# the database named above, which is the safe default.
#
# The evaluation suite CREATES, MIGRATES and TRUNCATES whatever it is pointed
# at, so it refuses outright to touch a database whose name does not end in
# `_evals`. Do not point this at anything you want to keep.
VOICEDESK_EVAL_DATABASE_URL=
